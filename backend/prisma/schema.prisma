  aadhaarVerifiedAt   DateTime?        @map("aadhaar_verified_at")
  aadhaarVerifiedById String?          @map("aadhaar_verified_by_id") @db.Char(36)
  bankStatus          String           @default("PENDING") @map("bank_status") @db.VarChar(30)
  bankVerifiedAt      DateTime?        @map("bank_verified_at")
  bankVerifiedById    String?          @map("bank_verified_by_id") @db.Char(36)
  overallStatus       String           @default("PENDING") @map("overall_status") @db.VarChar(30)
  verifiedAt          DateTime?        @map("verified_at")
  verifiedById        String?          @map("verified_by_id") @db.Char(36)
  rejectionReason     String?          @map("rejection_reason") @db.Text
