enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecisionType {
  APPROVED
  REJECTED
}

enum NotificationCategory {
  APPROVAL
  TASK
  SYSTEM
  ALERT
}

enum IntegrationJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRY_SCHEDULED
  CANCELLED
}

model ApprovalRequest {
  id                  String         @id @default(uuid()) @db.Char(36)
  companyId           String         @map("company_id") @db.Char(36)
  entityType          String         @map("entity_type") @db.VarChar(60)
  entityId            String         @map("entity_id") @db.Char(36)
  documentVersionId   String?        @map("document_version_id") @db.Char(36)
  createdById         String         @map("created_by_id") @db.Char(36)
  createdByName       String         @map("created_by_name") @db.VarChar(180)
  currentApproverRole String?        @map("current_approver_role") @db.VarChar(60)
  currentApproverId   String?        @map("current_approver_id") @db.Char(36)
  approvalLevel       Int            @default(1) @map("approval_level")
  maxLevels           Int            @default(1) @map("max_levels")
  status              ApprovalStatus @default(PENDING)
  title               String         @db.VarChar(200)
  summary             String?        @db.Text
  amount              Decimal?       @db.Decimal(15, 2)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  company   ClientAdmin        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  decisions ApprovalDecision[]

  @@index([companyId, status])
  @@index([companyId, entityType, entityId])
  @@map("approval_requests")
}

