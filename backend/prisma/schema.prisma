// Prisma schema for AZZUNIQE CRM & ERP - Super Admin & Hierarchy Architecture
// Based on Super Admin & Service -> Module -> Sub-Module specification

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  INACTIVE
}

enum AccessMode {
  FULL
  CUSTOM
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

// 7.8 Super Admin (Platform Owner)
model SuperAdmin {
  id           String    @id @default(uuid()) @db.Char(36)
  name         String    @db.VarChar(150)
  email        String    @unique @db.VarChar(180)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  status       Status    @default(ACTIVE)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  createdServices   Service[]
  createdModules    Module[]
  createdSubModules SubModule[]
  createdClients    ClientAdmin[]
  auditLogs         AuditLog[]

  @@map("super_admins")
}

// 7.1 Services (e.g. CRM & Sales, Purchase & Vendor, Inventory, Accounts)
model Service {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(80)
  description String?  @db.Text
  status      Status   @default(ACTIVE)
  orderNo     Int      @default(0) @map("order_no")
  createdBy   String?  @map("created_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  superAdmin SuperAdmin? @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  modules    Module[]
  subModules SubModule[]

  clientServiceAccess   ClientServiceAccess[]
  clientModuleAccess    ClientModuleAccess[]
  clientSubModuleAccess ClientSubModuleAccess[]
  departments           Department[]
  companyServiceTeams   CompanyServiceTeam[]
  workItems             ServiceWorkItem[]

  @@map("services")
}

// 7.2 Main Modules (e.g. CRM, Product, Sales under CRM & Sales)
model Module {
  id          String   @id @default(uuid()) @db.Char(36)
  serviceId   String   @map("service_id") @db.Char(36)
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(80)
  description String?  @db.Text
  icon        String?  @db.VarChar(120)
  orderNo     Int      @default(0) @map("order_no")
  status      Status   @default(ACTIVE)
  createdBy   String?  @map("created_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  superAdmin SuperAdmin? @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  subModules SubModule[]

  clientModuleAccess    ClientModuleAccess[]
  clientSubModuleAccess ClientSubModuleAccess[]

  @@map("modules")
}

// 7.3 Sub-Modules (Feature / Screen level, e.g. Leads, Quotation, PI, Sales Order)
model SubModule {
  id        String   @id @default(uuid()) @db.Char(36)
  moduleId  String   @map("module_id") @db.Char(36)
  serviceId String   @map("service_id") @db.Char(36)
  name      String   @db.VarChar(150)
  code      String   @unique @db.VarChar(80)
  route     String?  @db.VarChar(255)
  icon      String?  @db.VarChar(120)
  orderNo   Int      @default(0) @map("order_no")
  status    Status   @default(ACTIVE)
  createdBy String?  @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  module     Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  superAdmin SuperAdmin? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  clientSubModuleAccess ClientSubModuleAccess[]

  @@map("sub_modules")
}

// 7.4 Client / Admin / Company (PDF's Super Admin - Tenant Provisioned by Platform Super Admin)
model ClientAdmin {
  id               String    @id @default(uuid()) @db.Char(36)
  name             String    @db.VarChar(150)
  email            String    @unique @db.VarChar(180)
  mobile           String?   @db.VarChar(30)
  organizationName String    @map("organization_name") @db.VarChar(180)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  status           Status    @default(ACTIVE)
  themeColor       String?   @default("#7f22fe") @map("theme_color") @db.VarChar(30)
  createdBy        String?   @map("created_by") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  superAdmin SuperAdmin? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  serviceAccess   ClientServiceAccess[]
  moduleAccess    ClientModuleAccess[]
  subModuleAccess ClientSubModuleAccess[]
  departments     Department[]
  employees       CompanyEmployee[]
  serviceTeams    CompanyServiceTeam[]
  workItems       ServiceWorkItem[]
  leads           Lead[]
  leadIntegrations CompanyLeadIntegration[]
  customers       CrmCustomer[]
  contacts        CrmContact[]
  opportunities   CrmOpportunity[]
  products        Product[]
  productCategories ProductCategory[]
  productPricings ProductPricing[]
  salesOrders     SalesOrder[]
  quotations      SalesQuotation[]
  proformas       SalesProforma[]
  vendors         Vendor[]
  inventoryStocks InventoryStock[]

  @@map("Admins")
}

// 7.5 Client Service Access Mapping
model ClientServiceAccess {
  adminId       String     @map("admin_id") @db.Char(36)
  serviceId     String     @map("service_id") @db.Char(36)
  accessMode    AccessMode @default(CUSTOM) @map("access_mode")
  isFullService Boolean    @default(false) @map("is_full_service")
  isAllowed     Boolean    @default(true) @map("is_allowed")
  assignedBy    String?    @map("assigned_by") @db.Char(36)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  admin   ClientAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([adminId, serviceId])
  @@map("Admin_service_access")
}

// 7.6 Client Module Access Mapping
model ClientModuleAccess {
  adminId    String     @map("admin_id") @db.Char(36)
  serviceId  String     @map("service_id") @db.Char(36)
  moduleId   String     @map("module_id") @db.Char(36)
  accessMode AccessMode @default(FULL) @map("access_mode")
  isAllowed  Boolean    @default(true) @map("is_allowed")
  assignedBy String?    @map("assigned_by") @db.Char(36)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  admin   ClientAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  module  Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([adminId, serviceId, moduleId])
  @@map("Admin_module_access")
}

// 7.7 Client Sub-Module Access Mapping
model ClientSubModuleAccess {
  adminId     String   @map("admin_id") @db.Char(36)
  serviceId   String   @map("service_id") @db.Char(36)
  moduleId    String   @map("module_id") @db.Char(36)
  subModuleId String   @map("sub_module_id") @db.Char(36)
  isAllowed   Boolean  @default(true) @map("is_allowed")
  assignedBy  String?  @map("assigned_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  admin     ClientAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  module    Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  subModule SubModule   @relation(fields: [subModuleId], references: [id], onDelete: Cascade)

  @@id([adminId, serviceId, moduleId, subModuleId])
  @@map("Admin_sub_module_access")
}

// 7.10 Audit Logs
model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  actorId    String?  @map("actor_id") @db.Char(36)
  action     String   @db.VarChar(100) // CREATE, UPDATE, STATUS, ACCESS
  entityType String   @map("entity_type") @db.VarChar(100) // SERVICE, MODULE, SUB_MODULE, CLIENT_ADMIN, ACCESS
  entityId   String?  @map("entity_id") @db.Char(36)
  oldValue   String?  @map("old_value") @db.Text
  newValue   String?  @map("new_value") @db.Text
  reason     String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  superAdmin SuperAdmin? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

// 7.11 Service-Based Departments (Enforces company and assigned-service isolation)
model Department {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @map("company_id") @db.Char(36)
  serviceId   String   @map("service_id") @db.Char(36)
  name        String   @db.VarChar(150)
  code        String   @db.VarChar(80)
  description String?  @db.Text
  headId      String?  @map("head_id") @db.Char(36)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clientAdmin ClientAdmin       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  head        CompanyEmployee?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees   CompanyEmployee[] @relation("DepartmentEmployees")

  @@unique([companyId, serviceId, code])
  @@map("departments")
}

// Named teams scoped to a company and assigned service
model CompanyServiceTeam {
  id             String   @id @default(uuid()) @db.Char(36)
  companyId      String   @map("company_id") @db.Char(36)
  serviceId      String   @map("service_id") @db.Char(36)
  name           String   @db.VarChar(150)
  description    String?  @db.Text
  headEmployeeId String?  @unique @map("head_employee_id") @db.Char(36)
  status         Status   @default(ACTIVE)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  clientAdmin ClientAdmin       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  head        CompanyEmployee?  @relation("ServiceTeamHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  employees   CompanyEmployee[] @relation("ServiceTeamEmployees")

  @@unique([companyId, serviceId, name])
  @@index([companyId, serviceId])
  @@map("company_service_teams")
}

// 7.12 Company Employees & Internal Staff Members
model CompanyEmployee {
  id           String   @id @default(uuid()) @db.Char(36)
  companyId    String   @map("company_id") @db.Char(36)
  departmentId String?  @map("department_id") @db.Char(36)
  teamId       String?  @map("team_id") @db.Char(36)
  name         String   @db.VarChar(150)
  email        String   @db.VarChar(180)
  phone        String?  @db.VarChar(40)
  role         String   @db.VarChar(100)
  accessRole   String   @default("EMPLOYEE") @map("access_role") @db.VarChar(30)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  permissions  Json?
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clientAdmin       ClientAdmin          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department        Department?          @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  team              CompanyServiceTeam?  @relation("ServiceTeamEmployees", fields: [teamId], references: [id], onDelete: SetNull)
  headedDepartments Department[]         @relation("DepartmentHead")
  headedTeams       CompanyServiceTeam[] @relation("ServiceTeamHead")
  createdWorkItems  ServiceWorkItem[]    @relation("WorkItemCreator")
  assignedWorkItems ServiceWorkItem[]    @relation("WorkItemAssignee")
  workUpdates       ServiceWorkUpdate[]

  @@unique([companyId, email])
  @@map("company_employees")
}

model ServiceWorkItem {
  id            String         @id @default(uuid()) @db.Char(36)
  companyId     String         @map("company_id") @db.Char(36)
  serviceId     String         @map("service_id") @db.Char(36)
  createdById   String?        @map("created_by_id") @db.Char(36)
  createdByName String         @map("created_by_name") @db.VarChar(180)
  assignedToId  String         @map("assigned_to_id") @db.Char(36)
  title         String         @db.VarChar(180)
  description   String?        @db.Text
  status        WorkItemStatus @default(TODO)
  progress      Int            @default(0)
  dueDate       DateTime?      @map("due_date") @db.DateTime(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  company  ClientAdmin         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service  Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  creator  CompanyEmployee?    @relation("WorkItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee CompanyEmployee     @relation("WorkItemAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  updates  ServiceWorkUpdate[]

  @@index([companyId, serviceId, status])
  @@index([assignedToId, status])
  @@map("service_work_items")
}

model ServiceWorkUpdate {
  id         String          @id @default(uuid()) @db.Char(36)
  workItemId String          @map("work_item_id") @db.Char(36)
  authorId   String?         @map("author_id") @db.Char(36)
  authorName String          @map("author_name") @db.VarChar(180)
  status     WorkItemStatus?
  progress   Int?
  note       String?         @db.Text
  createdAt  DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  workItem ServiceWorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author   CompanyEmployee? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workItemId, createdAt])
  @@map("service_work_updates")
}

model Lead {
  id           String     @id @default(uuid()) @db.Char(36)
  companyId    String     @map("company_id") @db.Char(36)
  name         String     @db.VarChar(150)
  company      String?    @db.VarChar(180)
  email        String     @db.VarChar(180)
  phone        String?    @db.VarChar(40)
  source       String     @default("Website Inquiry") @db.VarChar(100)
  externalId   String?    @map("external_id") @db.VarChar(191)
  value        Decimal?   @db.Decimal(15, 2)
  requirements String?    @db.Text
  assignedTo   String?    @map("assigned_to") @db.VarChar(150)
  status       LeadStatus @default(NEW)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  clientAdmin ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([companyId, externalId])
  @@map("crm_leads")
}

model CompanyLeadIntegration {
  id             String    @id @default(uuid()) @db.Char(36)
  companyId      String    @map("company_id") @db.Char(36)
  provider       String    @db.VarChar(50) // INDIAMART, META_FACEBOOK, META_INSTAGRAM, WEBSITE_WEBHOOK, GMAIL, JUSTDIAL
  status         Status    @default(ACTIVE)
  credentials    Json?     // stores API key, CRM key, pageId, etc.
  webhookToken   String?   @unique @map("webhook_token") @db.VarChar(100)
  lastSyncAt     DateTime? @map("last_sync_at")
  totalSynced    Int       @default(0) @map("total_synced")
  lastSyncStatus String?   @map("last_sync_status") @db.VarChar(50)
  lastSyncError  String?   @map("last_sync_error") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  clientAdmin ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId, status])
  @@map("company_lead_integrations")
}

model CrmCustomer {
  id            String      @id @default(uuid()) @db.Char(36)
  companyId     String      @map("company_id") @db.Char(36)
  companyName   String      @map("company_name") @db.VarChar(180)
  gstin         String?     @db.VarChar(50)
  contactPerson String?     @map("contact_person") @db.VarChar(150)
  email         String?     @db.VarChar(180)
  phone         String?     @db.VarChar(40)
  industry      String      @default("Technology & IT") @db.VarChar(100)
  requirements  String?     @db.Text
  assignedTo    String?     @map("assigned_to") @db.VarChar(150)
  status        String      @default("ACTIVE") @db.VarChar(30)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  clientAdmin   ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@map("crm_customers")
}

model CrmContact {
  id          String      @id @default(uuid()) @db.Char(36)
  companyId   String      @map("company_id") @db.Char(36)
  name        String      @db.VarChar(150)
  companyName String?     @map("company_name") @db.VarChar(180)
  role        String?     @db.VarChar(100)
  email       String?     @db.VarChar(180)
  phone       String?     @db.VarChar(40)
  channel     String      @default("Email") @db.VarChar(50)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  clientAdmin ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@map("crm_contacts")
}

model CrmOpportunity {
  id                String      @id @default(uuid()) @db.Char(36)
  companyId         String      @map("company_id") @db.Char(36)
  title             String      @db.VarChar(180)
  companyName       String      @map("company_name") @db.VarChar(180)
  stage             String      @default("DISCOVERY") @db.VarChar(60)
  value             Decimal?    @db.Decimal(15, 2)
  expectedCloseDate DateTime?   @map("expected_close_date")
  probability       String?     @default("50%") @db.VarChar(20)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  clientAdmin       ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, stage, createdAt])
  @@map("crm_opportunities")
}

model Product {
  id            String           @id @default(uuid()) @db.Char(36)
  companyId     String           @map("company_id") @db.Char(36)
  sku           String           @db.VarChar(60)
  name          String           @db.VarChar(180)
  description   String?          @db.Text
  category      String           @default("Finished Goods") @db.VarChar(100)
  uom           String           @default("PCS") @db.VarChar(30)
  sellingPrice  Decimal          @default(0) @map("selling_price") @db.Decimal(15, 2)
  purchasePrice Decimal          @default(0) @map("purchase_price") @db.Decimal(15, 2)
  taxRate       Decimal          @default(18) @map("tax_rate") @db.Decimal(5, 2)
  stock         Int              @default(0)
  status        String           @default("ACTIVE") @db.VarChar(30)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  clientAdmin   ClientAdmin      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  pricings      ProductPricing[]

  @@unique([companyId, sku])
  @@index([companyId, category, status])
  @@map("products")
}

model ProductCategory {
  id          String      @id @default(uuid()) @db.Char(36)
  companyId   String      @map("company_id") @db.Char(36)
  name        String      @db.VarChar(100)
  description String?     @db.VarChar(255)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  clientAdmin ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("product_categories")
}

model ProductPricing {
  id            String      @id @default(uuid()) @db.Char(36)
  companyId     String      @map("company_id") @db.Char(36)
  productId     String      @map("product_id") @db.Char(36)
  planName      String      @default("Standard Rate") @map("plan_name") @db.VarChar(100)
  sellingPrice  Decimal     @default(0) @map("selling_price") @db.Decimal(15, 2)
  purchasePrice Decimal     @default(0) @map("purchase_price") @db.Decimal(15, 2)
  taxRate       Decimal     @default(18) @map("tax_rate") @db.Decimal(5, 2)
  discountRate  Decimal     @default(0) @map("discount_rate") @db.Decimal(5, 2)
  validFrom     DateTime?   @map("valid_from")
  validUntil    DateTime?   @map("valid_until")
  isDefault     Boolean     @default(false) @map("is_default")
  status        String      @default("ACTIVE") @db.VarChar(30)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  clientAdmin   ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId])
  @@map("product_pricings")
}

model SalesOrder {
  id            String      @id @default(uuid()) @db.Char(36)
  companyId     String      @map("company_id") @db.Char(36)
  orderNo       String      @map("order_no") @db.VarChar(60)
  customer      String      @db.VarChar(180)
  date          DateTime    @default(now())
  itemsCount    Int         @default(1) @map("items_count")
  amount        Decimal     @default(0) @db.Decimal(15, 2)
  items         Json?
  notes         String?     @db.Text
  assignedTo    String?     @map("assigned_to") @db.VarChar(150)
  status        String      @default("PENDING_APPROVAL") @db.VarChar(50)
  paymentStatus String      @default("PENDING") @map("payment_status") @db.VarChar(50)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  clientAdmin   ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, orderNo])
  @@index([companyId, status, date])
  @@map("sales_orders")
}

model SalesQuotation {
  id          String      @id @default(uuid()) @db.Char(36)
  companyId   String      @map("company_id") @db.Char(36)
  quoteNo     String      @map("quote_no") @db.VarChar(60)
  customer    String      @db.VarChar(180)
  title       String      @db.VarChar(180)
  amount      Decimal     @default(0) @db.Decimal(15, 2)
  items       Json?
  notes       String?     @db.Text
  validUntil  DateTime?   @map("valid_until")
  status      String      @default("SENT") @db.VarChar(50)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  clientAdmin ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, quoteNo])
  @@index([companyId, status, createdAt])
  @@map("sales_quotations")
}

model SalesProforma {
  id          String      @id @default(uuid()) @db.Char(36)
  companyId   String      @map("company_id") @db.Char(36)
  invoiceNo   String      @map("invoice_no") @db.VarChar(60)
  customer    String      @db.VarChar(180)
  orderRef    String?     @map("order_ref") @db.VarChar(60)
  amount      Decimal     @default(0) @db.Decimal(15, 2)
  date        DateTime    @default(now())
  status      String      @default("ISSUED") @db.VarChar(50)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  clientAdmin ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, invoiceNo])
  @@index([companyId, status, date])
  @@map("sales_proforma_invoices")
}

model Vendor {
  id          String      @id @default(uuid()) @db.Char(36)
  companyId   String      @map("company_id") @db.Char(36)
  name        String      @db.VarChar(180)
  contact     String?     @db.VarChar(150)
  email       String?     @db.VarChar(180)
  phone       String?     @db.VarChar(40)
  category    String      @default("Raw Materials") @db.VarChar(100)
  rating      String?     @default("5.0 ★") @db.VarChar(30)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  clientAdmin ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, category, createdAt])
  @@map("vendors")
}

model InventoryStock {
  id           String      @id @default(uuid()) @db.Char(36)
  companyId    String      @map("company_id") @db.Char(36)
  sku          String      @db.VarChar(60)
  name         String      @db.VarChar(180)
  warehouse    String      @default("Main Warehouse") @db.VarChar(100)
  stock        Int         @default(0)
  reorderLevel Int         @default(10) @map("reorder_level")
  uom          String      @default("PCS") @db.VarChar(30)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  clientAdmin  ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, sku, warehouse])
  @@index([companyId, warehouse])
  @@map("inventory_stocks")
}
