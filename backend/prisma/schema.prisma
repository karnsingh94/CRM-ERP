// ====================================================================
// PHASE 9: HRMS, ATTENDANCE & PAYROLL ENTERPRISE MODELS
// ====================================================================

// 9.1 Company Employee Designation Master
model EmployeeDesignation {
  id           String            @id @default(uuid()) @db.Char(36)
  companyId    String            @map("company_id") @db.Char(36)
  code         String            @db.VarChar(50)
  title        String            @db.VarChar(120)
  description  String?           @db.Text
  departmentId String?           @map("department_id") @db.Char(36)
  level        Int?              @default(1)
  minSalary    Decimal?          @map("min_salary") @db.Decimal(15, 2)
  maxSalary    Decimal?          @map("max_salary") @db.Decimal(15, 2)
  status       String            @default("ACTIVE") @db.VarChar(30)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  clientAdmin  ClientAdmin       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  profiles     EmployeeProfile[]

  @@unique([companyId, code])
  @@index([companyId, departmentId])
  @@map("employee_designations")
}

// 9.2 Enterprise HR Employee Profile (Decoupled from Auth User)
model EmployeeProfile {
  id                    String                     @id @default(uuid()) @db.Char(36)
  companyId             String                     @map("company_id") @db.Char(36)
  employeeId            String?                    @unique @map("employee_id") @db.Char(36)
  employeeCode          String                     @map("employee_code") @db.VarChar(60)
  firstName             String                     @map("first_name") @db.VarChar(100)
  lastName              String?                    @map("last_name") @db.VarChar(100)
  displayName           String                     @map("display_name") @db.VarChar(200)
  gender                String?                    @db.VarChar(20)
  dateOfBirth           DateTime?                  @map("date_of_birth") @db.Date
  dateOfJoining         DateTime                   @map("date_of_joining") @db.Date
  confirmationDate      DateTime?                  @map("confirmation_date") @db.Date
  probationEndDate      DateTime?                  @map("probation_end_date") @db.Date
  resignationDate       DateTime?                  @map("resignation_date") @db.Date
  relievingDate         DateTime?                  @map("relieving_date") @db.Date
  employmentStatus      String                     @default("ACTIVE") @map("employment_status") @db.VarChar(40)
  employmentType        String                     @default("FULL_TIME") @map("employment_type") @db.VarChar(40)
  departmentId          String?                    @map("department_id") @db.Char(36)
  designationId         String?                    @map("designation_id") @db.Char(36)
  reportingManagerId    String?                    @map("reporting_manager_id") @db.Char(36)
  workEmail             String?                    @map("work_email") @db.VarChar(180)
  personalEmail         String?                    @map("personal_email") @db.VarChar(180)
  phone                 String?                    @db.VarChar(40)
  emergencyContactName  String?                    @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone String?                    @map("emergency_contact_phone") @db.VarChar(40)
  bloodGroup            String?                    @map("blood_group") @db.VarChar(10)
  maritalStatus         String?                    @map("marital_status") @db.VarChar(20)
  currentAddress        String?                    @map("current_address") @db.Text
  permanentAddress      String?                    @map("permanent_address") @db.Text

  // Bank Disbursement Details (Masked for standard UI + Encrypted for disbursement storage)
  bankName              String?                    @map("bank_name") @db.VarChar(100)
  bankBranch            String?                    @map("bank_branch") @db.VarChar(100)
  bankIfsc              String?                    @map("bank_ifsc") @db.VarChar(30)
  bankAccountMasked     String?                    @map("bank_account_masked") @db.VarChar(30)
  bankAccountEncrypted  String?                    @map("bank_account_encrypted") @db.Text

  // Sensitive Statutory Identifiers (Masked for standard UI + Encrypted storage)
  panMasked             String?                    @map("pan_masked") @db.VarChar(20)
  panEncrypted          String?                    @map("pan_encrypted") @db.Text
  aadhaarMasked         String?                    @map("aadhaar_masked") @db.VarChar(20)
  aadhaarEncrypted      String?                    @map("aadhaar_encrypted") @db.Text
  uanNumber             String?                    @map("uan_number") @db.VarChar(30)
  esicNumber            String?                    @map("esic_number") @db.VarChar(30)

  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  clientAdmin           ClientAdmin                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee              CompanyEmployee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  department            Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation           EmployeeDesignation?       @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingManager      EmployeeProfile?           @relation("ReportingHierarchy", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  subordinates          EmployeeProfile[]          @relation("ReportingHierarchy")

  kycRecord             EmployeeKyc?
  documents             EmployeeDocument[]
  shiftRosters          EmployeeShiftRoster[]
  attendances           DailyAttendance[]
  attendanceRegularizations AttendanceRegularization[]
  leaveBalances         EmployeeLeaveBalance[]
  leaveRequests         LeaveRequest[]
  salaryAssignments     EmployeeSalaryAssignment[]
  payrollItems          PayrollItem[]
  payslips              EmployeePayslip[]
  punchLogs             BiometricPunchLog[]

  @@unique([companyId, employeeCode])
  @@index([companyId, departmentId])
  @@index([companyId, designationId])
  @@index([companyId, reportingManagerId])
  @@index([companyId, employmentStatus])
  @@map("employee_profiles")
}

// 9.3 Employee Onboarding & KYC Verification Workflow
