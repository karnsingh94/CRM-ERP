  startDate         DateTime        @map("start_date") @db.Date
  endDate           DateTime?       @map("end_date") @db.Date
  isWeeklyOff       Boolean         @default(false) @map("is_weekly_off")
  notes             String?         @db.VarChar(255)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  clientAdmin       ClientAdmin     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile           EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  shift             ShiftPolicy     @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeProfileId, startDate])
  @@map("employee_shift_rosters")
}

// 9.7 Processed Daily Attendance Register
model DailyAttendance {
  id                String          @id @default(uuid()) @db.Char(36)
  companyId         String          @map("company_id") @db.Char(36)
  employeeProfileId String          @map("employee_profile_id") @db.Char(36)
  attendanceDate    DateTime        @map("attendance_date") @db.Date
  shiftId           String?         @map("shift_id") @db.Char(36)
  firstInTime       DateTime?       @map("first_in_time")
  lastOutTime       DateTime?       @map("last_out_time")
  totalWorkHours    Decimal         @default(0.00) @map("total_work_hours") @db.Decimal(5, 2)
  breakHours        Decimal         @default(0.00) @map("break_hours") @db.Decimal(4, 2)
  overtimeHours     Decimal         @default(0.00) @map("overtime_hours") @db.Decimal(5, 2)
  lateMinutes       Int             @default(0) @map("late_minutes")
  earlyExitMinutes  Int             @default(0) @map("early_exit_minutes")
  status            String          @default("PRESENT") @db.VarChar(30)
  isRegularized     Boolean         @default(false) @map("is_regularized")
