// Prisma schema for AZZUNIQUE CRM & ERP - Super Admin & Hierarchy Architecture
// Based on Super Admin & Service -> Module -> Sub-Module specification

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE
  INACTIVE
}

enum AccessMode {
  FULL
  CUSTOM
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

// 7.8 Super Admin (Platform Owner)
model SuperAdmin {
  id           String    @id @default(uuid()) @db.Char(36)
  name         String    @db.VarChar(150)
  email        String    @unique @db.VarChar(180)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  status       Status    @default(ACTIVE)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  createdServices   Service[]
  createdModules    Module[]
  createdSubModules SubModule[]
  createdClients    ClientAdmin[]
  auditLogs         AuditLog[]

  @@map("super_admins")
}

// 7.1 Services (e.g. CRM & Sales, Purchase & Vendor, Inventory, Accounts)
model Service {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(80)
  description String?  @db.Text
  status      Status   @default(ACTIVE)
  orderNo     Int      @default(0) @map("order_no")
  createdBy   String?  @map("created_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  superAdmin SuperAdmin? @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  modules    Module[]
  subModules SubModule[]

  clientServiceAccess   ClientServiceAccess[]
  clientModuleAccess    ClientModuleAccess[]
  clientSubModuleAccess ClientSubModuleAccess[]
  departments           Department[]
  companyServiceTeams   CompanyServiceTeam[]
  workItems             ServiceWorkItem[]

  @@map("services")
}

// 7.2 Main Modules (e.g. CRM, Product, Sales under CRM & Sales)
model Module {
  id          String   @id @default(uuid()) @db.Char(36)
  serviceId   String   @map("service_id") @db.Char(36)
  name        String   @db.VarChar(150)
  code        String   @unique @db.VarChar(80)
  description String?  @db.Text
  icon        String?  @db.VarChar(120)
  orderNo     Int      @default(0) @map("order_no")
  status      Status   @default(ACTIVE)
  createdBy   String?  @map("created_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  superAdmin SuperAdmin? @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  subModules SubModule[]

  clientModuleAccess    ClientModuleAccess[]
  clientSubModuleAccess ClientSubModuleAccess[]

  @@map("modules")
}

// 7.3 Sub-Modules (Feature / Screen level, e.g. Leads, Quotation, PI, Sales Order)
model SubModule {
  id        String   @id @default(uuid()) @db.Char(36)
  moduleId  String   @map("module_id") @db.Char(36)
  serviceId String   @map("service_id") @db.Char(36)
  name      String   @db.VarChar(150)
  code      String   @unique @db.VarChar(80)
  route     String?  @db.VarChar(255)
  icon      String?  @db.VarChar(120)
  orderNo   Int      @default(0) @map("order_no")
  status    Status   @default(ACTIVE)
  createdBy String?  @map("created_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  module     Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  service    Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  superAdmin SuperAdmin? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  clientSubModuleAccess ClientSubModuleAccess[]

  @@map("sub_modules")
}

// 7.4 Client / Admin / Company (PDF's Super Admin - Tenant Provisioned by Platform Super Admin)
model ClientAdmin {
  id               String    @id @default(uuid()) @db.Char(36)
  name             String    @db.VarChar(150)
  email            String    @unique @db.VarChar(180)
  mobile           String?   @db.VarChar(30)
  organizationName String    @map("organization_name") @db.VarChar(180)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  status           Status    @default(ACTIVE)
  themeColor       String?   @default("#7f22fe") @map("theme_color") @db.VarChar(30)
  createdBy        String?   @map("created_by") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  superAdmin SuperAdmin? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  serviceAccess   ClientServiceAccess[]
  moduleAccess    ClientModuleAccess[]
  subModuleAccess ClientSubModuleAccess[]
  departments     Department[]
  employees       CompanyEmployee[]
  serviceTeams    CompanyServiceTeam[]
  workItems       ServiceWorkItem[]
  leads           Lead[]
  leadIntegrations CompanyLeadIntegration[]
  customers       CrmCustomer[]
  contacts        CrmContact[]
  opportunities   CrmOpportunity[]
  products        Product[]
  productCategories ProductCategory[]
  productPricings ProductPricing[]
  salesOrders     SalesOrder[]
  quotations      SalesQuotation[]
  proformas       SalesProforma[]
  vendors         Vendor[]
  inventoryStocks InventoryStock[]
  inventoryBatches InventoryBatch[]
  inventoryWarehouses          InventoryWarehouse[]
  inventoryMovements           InventoryMovement[]
  inventoryFulfillments        InventoryFulfillment[]
  inventoryMaterialRequests    InventoryMaterialRequest[]
  inventoryProcurementRequests InventoryProcurementRequest[]
  inventoryProductionReceipts  InventoryProductionReceipt[]
  inventoryBins                InventoryBin[]
  inventoryTransfers           InventoryTransfer[]
  purchaseRequests             PurchaseRequest[]
  purchaseQuotations           PurchaseQuotation[]
  purchaseOrders               PurchaseOrder[]
  purchaseReceipts             PurchaseReceipt[]
  purchaseReturns              PurchaseReturn[]
  purchaseBills                PurchaseBill[]
  approvalRequests             ApprovalRequest[]
  documentVersions             DocumentVersion[]
  attachments                  Attachment[]
  notifications                Notification[]
  integrationJobs              IntegrationJob[]
  auditLogs                    AuditLog[]
  crmCommunications            CrmCommunication[]
  customerAdvances             CustomerAdvance[]
  artworkProofs                PurchaseArtworkProof[]
  purchaseDeviations           PurchaseDeviation[]
  inventoryReservations        InventoryReservation[]
  inventorySamplings           InventorySampling[]
  inventoryGatePasses          InventoryGatePass[]
  inventoryPhysicalVerifications InventoryPhysicalVerification[]
  inventoryAdjustments         InventoryAdjustment[]
  bomMasters                   BomMaster[]
  bomItems                     BomItem[]
  productionPlans              ProductionPlan[]
  productionOrders             ProductionOrder[]
  productionMaterialRequirements ProductionMaterialRequirement[]
  manufacturingBatches         ManufacturingBatch[]
  manufacturingBatchMaterials  ManufacturingBatchMaterial[]
  manufacturingProcessSteps    ManufacturingProcessStep[]
  dailyProductionReports       DailyProductionReport[]
  manufacturingQcs             ManufacturingQC[]
  manufacturingReprocessings   ManufacturingReprocessing[]
  jobWorkOrders                JobWorkOrder[]
  jobWorkChallans              JobWorkChallan[]
  jobWorkReceipts              JobWorkReceipt[]
  jobWorkReconciliations       JobWorkReconciliation[]
  dispatchOrders               DispatchOrder[]
  dispatchOrderItems           DispatchOrderItem[]
  dispatchItemBatchAllocations DispatchItemBatchAllocation[]
  dispatchPackages             DispatchPackage[]
  dispatchTrackings            DispatchTracking[]
  customerReturns              CustomerReturn[]
  customerReturnItems          CustomerReturnItem[]
  customerReturnInspections    CustomerReturnInspection[]
  customerCreditNotes          CustomerCreditNote[]
  financialYears               FinancialYear[]
  accountingPeriods            AccountingPeriod[]
  accountGroups                AccountGroup[]
  accountMasters               AccountMaster[]
  bankAccounts                 BankAccount[]
  salesInvoices                SalesInvoice[]
  salesInvoiceItems            SalesInvoiceItem[]
  journalVouchers              JournalVoucher[]
  journalVoucherItems          JournalVoucherItem[]
  paymentReceipts              PaymentReceipt[]
  paymentAllocations           PaymentAllocation[]
  vendorDebitNotes             VendorDebitNote[]
  bankTransactions             BankTransaction[]
  bankReconciliations          BankReconciliation[]
  bankReconciliationItems      BankReconciliationItem[]
  tallyLedgerMappings          TallyLedgerMapping[]
  tallySyncBatches             TallySyncBatch[]
  tallyVoucherMappings         TallyVoucherMapping[]

  // Phase 9: HRMS & Payroll
  employeeDesignations         EmployeeDesignation[]
  employeeProfiles             EmployeeProfile[]
  employeeKycs                 EmployeeKyc[]
  employeeDocuments            EmployeeDocument[]
  shiftPolicies                ShiftPolicy[]
  employeeShiftRosters         EmployeeShiftRoster[]
  dailyAttendances             DailyAttendance[]
  attendanceRegularizations     AttendanceRegularization[]
  leaveTypes                   LeaveType[]
  leavePolicies                LeavePolicy[]
  employeeLeaveBalances        EmployeeLeaveBalance[]
  leaveRequests                LeaveRequest[]
  biometricDevices             BiometricDevice[]
  biometricPunchLogs           BiometricPunchLog[]
  salaryComponents             SalaryComponent[]
  salaryStructures             SalaryStructure[]
  employeeSalaryAssignments     EmployeeSalaryAssignment[]
  payrollBatches               PayrollBatch[]
  payrollItems                 PayrollItem[]
  employeePayslips             EmployeePayslip[]
  statutoryRules               StatutoryRule[]

  // Phase 10: Solar Monitoring
  solarPlants                  SolarPlant[]
  solarInverters               SolarInverter[]
  solarPanelStrings            SolarPanelString[]
  solarPlantApiConfigs         SolarPlantApiConfig[]
  solarTelemetryLogs           SolarTelemetryLog[]
  solarInverterAlarms          SolarInverterAlarm[]
  solarCleaningSchedules       SolarCleaningSchedule[]
  solarMaintenanceTickets      SolarMaintenanceTicket[]

  @@map("Admins")
}

// 7.5 Client Service Access Mapping
model ClientServiceAccess {
  adminId       String     @map("admin_id") @db.Char(36)
  serviceId     String     @map("service_id") @db.Char(36)
  accessMode    AccessMode @default(CUSTOM) @map("access_mode")
  isFullService Boolean    @default(false) @map("is_full_service")
  isAllowed     Boolean    @default(true) @map("is_allowed")
  assignedBy    String?    @map("assigned_by") @db.Char(36)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  admin   ClientAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([adminId, serviceId])
  @@map("Admin_service_access")
}

// 7.6 Client Module Access Mapping
model ClientModuleAccess {
  adminId    String     @map("admin_id") @db.Char(36)
  serviceId  String     @map("service_id") @db.Char(36)
  moduleId   String     @map("module_id") @db.Char(36)
  accessMode AccessMode @default(FULL) @map("access_mode")
  isAllowed  Boolean    @default(true) @map("is_allowed")
  assignedBy String?    @map("assigned_by") @db.Char(36)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  admin   ClientAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  service Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  module  Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([adminId, serviceId, moduleId])
  @@map("Admin_module_access")
}

// 7.7 Client Sub-Module Access Mapping
model ClientSubModuleAccess {
  adminId     String   @map("admin_id") @db.Char(36)
  serviceId   String   @map("service_id") @db.Char(36)
  moduleId    String   @map("module_id") @db.Char(36)
  subModuleId String   @map("sub_module_id") @db.Char(36)
  isAllowed   Boolean  @default(true) @map("is_allowed")
  assignedBy  String?  @map("assigned_by") @db.Char(36)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  admin     ClientAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  module    Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  subModule SubModule   @relation(fields: [subModuleId], references: [id], onDelete: Cascade)

  @@id([adminId, serviceId, moduleId, subModuleId])
  @@map("Admin_sub_module_access")
}

// 7.10 Audit Logs
model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String?  @map("company_id") @db.Char(36)
  actorId     String?  @map("actor_id") @db.Char(36)
  userId      String?  @map("user_id") @db.Char(36)
  userName    String?  @map("user_name") @db.VarChar(180)
  serviceCode String?  @map("service_code") @db.VarChar(60)
  moduleCode  String?  @map("module_code") @db.VarChar(60)
  action      String   @db.VarChar(100) // CREATE, UPDATE, STATUS, ACCESS, APPROVE, REJECT, POST, DELETE
  entityType  String   @map("entity_type") @db.VarChar(100) // SERVICE, MODULE, SUB_MODULE, CLIENT_ADMIN, ACCESS, etc.
  entityId    String?  @map("entity_id") @db.Char(36)
  oldValue    String?  @map("old_value") @db.Text
  newValue    String?  @map("new_value") @db.Text
  beforeState String?  @map("before_state") @db.Text
  afterState  String?  @map("after_state") @db.Text
  reason      String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  superAdmin SuperAdmin?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  company    ClientAdmin? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// 7.11 Service-Based Departments (Enforces company and assigned-service isolation)
model Department {
  id          String   @id @default(uuid()) @db.Char(36)
  companyId   String   @map("company_id") @db.Char(36)
  serviceId   String   @map("service_id") @db.Char(36)
  name        String   @db.VarChar(150)
  code        String   @db.VarChar(80)
  description String?  @db.Text
  headId      String?  @map("head_id") @db.Char(36)
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clientAdmin ClientAdmin       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  head        CompanyEmployee?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  employees   CompanyEmployee[] @relation("DepartmentEmployees")
  designations EmployeeDesignation[]
  employeeProfiles EmployeeProfile[]

  @@unique([companyId, serviceId, code])
  @@map("departments")
}

// Named teams scoped to a company and assigned service
model CompanyServiceTeam {
  id             String   @id @default(uuid()) @db.Char(36)
  companyId      String   @map("company_id") @db.Char(36)
  serviceId      String   @map("service_id") @db.Char(36)
  name           String   @db.VarChar(150)
  description    String?  @db.Text
  headEmployeeId String?  @unique @map("head_employee_id") @db.Char(36)
  status         Status   @default(ACTIVE)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  clientAdmin ClientAdmin       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  head        CompanyEmployee?  @relation("ServiceTeamHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  employees   CompanyEmployee[] @relation("ServiceTeamEmployees")

  @@unique([companyId, serviceId, name])
  @@index([companyId, serviceId])
  @@map("company_service_teams")
}

// 7.12 Company Employees & Internal Staff Members
model CompanyEmployee {
  id           String   @id @default(uuid()) @db.Char(36)
  companyId    String   @map("company_id") @db.Char(36)
  departmentId String?  @map("department_id") @db.Char(36)
  teamId       String?  @map("team_id") @db.Char(36)
  name         String   @db.VarChar(150)
  email        String   @db.VarChar(180)
  phone        String?  @db.VarChar(40)
  role         String   @db.VarChar(100)
  accessRole   String   @default("EMPLOYEE") @map("access_role") @db.VarChar(30)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  permissions  Json?
  status       Status   @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clientAdmin       ClientAdmin          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department        Department?          @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  team              CompanyServiceTeam?  @relation("ServiceTeamEmployees", fields: [teamId], references: [id], onDelete: SetNull)
  headedDepartments Department[]         @relation("DepartmentHead")
  headedTeams       CompanyServiceTeam[] @relation("ServiceTeamHead")
  createdWorkItems  ServiceWorkItem[]    @relation("WorkItemCreator")
  assignedWorkItems ServiceWorkItem[]    @relation("WorkItemAssignee")
  workUpdates       ServiceWorkUpdate[]
  profile           EmployeeProfile?
  solarCleaningSchedules  SolarCleaningSchedule[]  @relation("SolarCleaningInspector")
  solarMaintenanceTickets SolarMaintenanceTicket[] @relation("SolarTicketTechnician")

  @@unique([companyId, email])
  @@map("company_employees")
}

model ServiceWorkItem {
  id            String         @id @default(uuid()) @db.Char(36)
  companyId     String         @map("company_id") @db.Char(36)
  serviceId     String         @map("service_id") @db.Char(36)
  createdById   String?        @map("created_by_id") @db.Char(36)
  createdByName String         @map("created_by_name") @db.VarChar(180)
  assignedToId  String         @map("assigned_to_id") @db.Char(36)
  title         String         @db.VarChar(180)
  description   String?        @db.Text
  status        WorkItemStatus @default(TODO)
  progress      Int            @default(0)
  priority      String         @default("MEDIUM") @db.VarChar(20)
  entityType    String?        @map("entity_type") @db.VarChar(60)
  entityId      String?        @map("entity_id") @db.Char(36)
  dueDate       DateTime?      @map("due_date") @db.DateTime(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  company  ClientAdmin         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  service  Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  creator  CompanyEmployee?    @relation("WorkItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee CompanyEmployee     @relation("WorkItemAssignee", fields: [assignedToId], references: [id], onDelete: Cascade)
  updates  ServiceWorkUpdate[]

  @@index([companyId, serviceId, status])
  @@index([assignedToId, status])
  @@map("service_work_items")
}

model ServiceWorkUpdate {
  id         String          @id @default(uuid()) @db.Char(36)
  workItemId String          @map("work_item_id") @db.Char(36)
  authorId   String?         @map("author_id") @db.Char(36)
  authorName String          @map("author_name") @db.VarChar(180)
  status     WorkItemStatus?
  progress   Int?
  note       String?         @db.Text
  createdAt  DateTime        @default(now()) @map("created_at") @db.DateTime(3)

  workItem ServiceWorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author   CompanyEmployee? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([workItemId, createdAt])
  @@map("service_work_updates")
}

model Lead {
  id                  String     @id @default(uuid()) @db.Char(36)
  companyId           String     @map("company_id") @db.Char(36)
  name                String     @db.VarChar(150)
  company             String?    @db.VarChar(180)
  email               String     @db.VarChar(180)
  phone               String?    @db.VarChar(40)
  source              String     @default("Website Inquiry") @db.VarChar(100)
  externalId          String?    @map("external_id") @db.VarChar(191)
  value               Decimal?   @db.Decimal(15, 2)
  requirements        String?    @db.Text
  assignedTo          String?    @map("assigned_to") @db.VarChar(150)
  priority            String     @default("MEDIUM") @db.VarChar(20)
  status              LeadStatus @default(NEW)
  nextFollowUpDate    DateTime?  @map("next_follow_up_date")
  followUpRemarks     String?    @map("follow_up_remarks") @db.Text
  convertedAt         DateTime?  @map("converted_at")
  convertedById       String?    @map("converted_by_id") @db.Char(36)
  convertedByName     String?    @map("converted_by_name") @db.VarChar(150)
  convertedCustomerId String?    @map("converted_customer_id") @db.Char(36)
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  clientAdmin ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, createdAt])
  @@index([companyId, externalId])
  @@index([companyId, phone])
  @@index([companyId, email])
  @@map("crm_leads")
}

model CompanyLeadIntegration {
  id             String    @id @default(uuid()) @db.Char(36)
  companyId      String    @map("company_id") @db.Char(36)
  provider       String    @db.VarChar(50) // INDIAMART, META_FACEBOOK, META_INSTAGRAM, WEBSITE_WEBHOOK, GMAIL, JUSTDIAL
  status         Status    @default(ACTIVE)
  credentials    Json? // stores API key, CRM key, pageId, etc.
  webhookToken   String?   @unique @map("webhook_token") @db.VarChar(100)
  lastSyncAt     DateTime? @map("last_sync_at")
  totalSynced    Int       @default(0) @map("total_synced")
  lastSyncStatus String?   @map("last_sync_status") @db.VarChar(50)
  lastSyncError  String?   @map("last_sync_error") @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  clientAdmin ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, provider])
  @@index([companyId, status])
  @@map("company_lead_integrations")
}

model CrmCustomer {
  id                    String            @id @default(uuid()) @db.Char(36)
  companyId             String            @map("company_id") @db.Char(36)
  companyName           String            @map("company_name") @db.VarChar(180)
  customerCode          String?           @map("customer_code") @db.VarChar(50)
  gstin                 String?           @db.VarChar(50)
  pan                   String?           @db.VarChar(20)
  contactPerson         String?           @map("contact_person") @db.VarChar(150)
  email                 String?           @db.VarChar(180)
  phone                 String?           @db.VarChar(40)
  industry              String            @default("Technology & IT") @db.VarChar(100)
  customerCategory      String            @default("DOMESTIC") @map("customer_category") @db.VarChar(50)
  billingAddress        String?           @map("billing_address") @db.Text
  shippingAddress       String?           @map("shipping_address") @db.Text
  city                  String?           @db.VarChar(100)
  state                 String?           @db.VarChar(100)
  pincode               String?           @db.VarChar(20)
  creditLimit           Decimal?          @default(0) @map("credit_limit") @db.Decimal(15, 2)
  paymentTerms          String?           @default("30% Advance, 70% against BL/Delivery") @map("payment_terms") @db.VarChar(255)
  requirements          String?           @db.Text
  assignedTo            String?           @map("assigned_to") @db.VarChar(150)
  reorderCycleDays      Int?              @default(30) @map("reorder_cycle_days")
  lastOrderDate         DateTime?         @map("last_order_date")
  expectedReorderDate   DateTime?         @map("expected_reorder_date")
  reorderReminderStatus String?           @default("PENDING") @map("reorder_reminder_status") @db.VarChar(30)
  status                String            @default("ACTIVE") @db.VarChar(30)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  clientAdmin     ClientAdmin       @relation(fields: [companyId], references: [id], onDelete: Cascade)
