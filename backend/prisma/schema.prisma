// 9.5 Shift Policy Master (Supports Shifts Crossing Midnight)
model ShiftPolicy {
  id                    String                @id @default(uuid()) @db.Char(36)
  companyId             String                @map("company_id") @db.Char(36)
  shiftName             String                @map("shift_name") @db.VarChar(100)
  shiftCode             String                @map("shift_code") @db.VarChar(50)
  startTime             String                @map("start_time") @db.VarChar(10)
  endTime               String                @map("end_time") @db.VarChar(10)
  isOvernight           Boolean               @default(false) @map("is_overnight")
  graceMinutes          Int                   @default(15) @map("grace_minutes")
  breakDurationMinutes  Int                   @default(60) @map("break_duration_minutes")
  halfDayThresholdHours Decimal               @default(4.00) @map("half_day_threshold_hours") @db.Decimal(4, 2)
  fullDayThresholdHours Decimal               @default(8.00) @map("full_day_threshold_hours") @db.Decimal(4, 2)
  isDefault             Boolean               @default(false) @map("is_default")
  status                String                @default("ACTIVE") @db.VarChar(30)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clientAdmin           ClientAdmin           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rosters               EmployeeShiftRoster[]
  attendances           DailyAttendance[]

  @@unique([companyId, shiftCode])
  @@map("shift_policies")
}

// 9.6 Employee Shift Roster & Schedule Assignment
model EmployeeShiftRoster {
  id                String          @id @default(uuid()) @db.Char(36)
