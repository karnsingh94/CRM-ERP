  punchType         String           @default("CHECK_IN") @map("punch_type") @db.VarChar(30)
  verificationMode  String?          @map("verification_mode") @db.VarChar(30)
  isProcessed       Boolean          @default(false) @map("is_processed")
  processedAt       DateTime?        @map("processed_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  clientAdmin       ClientAdmin      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  device            BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  profile           EmployeeProfile? @relation(fields: [employeeProfileId], references: [id], onDelete: SetNull)

  @@index([companyId, isProcessed, punchTime])
  @@index([companyId, employeeProfileId, punchTime])
  @@map("biometric_punch_logs")
}

// 9.15 Salary Component Master
model SalaryComponent {
  id              String       @id @default(uuid()) @db.Char(36)
  companyId       String       @map("company_id") @db.Char(36)
  name            String       @db.VarChar(100)
  code            String       @db.VarChar(50)
  type            String       @db.VarChar(30)
  calculationType String       @default("FLAT") @map("calculation_type") @db.VarChar(50)
  isTaxable       Boolean      @default(true) @map("is_taxable")
  isStatutory     Boolean      @default(false) @map("is_statutory")
  ledgerAccountId String?      @map("ledger_account_id") @db.Char(36)
  displayOrder    Int          @default(1) @map("display_order")
  status          String       @default("ACTIVE") @db.VarChar(30)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  clientAdmin     ClientAdmin  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@map("salary_components")
}

// 9.16 Salary Structure Master Template
model SalaryStructure {
  id             String                     @id @default(uuid()) @db.Char(36)
  companyId      String                     @map("company_id") @db.Char(36)
  name           String                     @db.VarChar(120)
  code           String                     @db.VarChar(50)
  description    String?                    @db.Text
  componentsJson Json                       @map("components_json")
  status         String                     @default("ACTIVE") @db.VarChar(30)
  createdAt      DateTime                   @default(now()) @map("created_at")
  updatedAt      DateTime                   @updatedAt @map("updated_at")

  clientAdmin    ClientAdmin                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments    EmployeeSalaryAssignment[]

  @@unique([companyId, code])
  @@map("salary_structures")
}

// 9.17 Employee Salary Assignment (Effective-Dated)
model EmployeeSalaryAssignment {
  id                  String          @id @default(uuid()) @db.Char(36)
  companyId           String          @map("company_id") @db.Char(36)
  employeeProfileId   String          @map("employee_profile_id") @db.Char(36)
  salaryStructureId   String          @map("salary_structure_id") @db.Char(36)
  ctcAnnual           Decimal         @map("ctc_annual") @db.Decimal(15, 2)
  ctcMonthly          Decimal         @map("ctc_monthly") @db.Decimal(15, 2)
  effectiveFrom       DateTime        @map("effective_from") @db.Date
  effectiveTo         DateTime?       @map("effective_to") @db.Date
  revisionReason      String?         @map("revision_reason") @db.VarChar(255)
  componentsBreakdown Json            @map("components_breakdown")
  status              String          @default("ACTIVE") @db.VarChar(30)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  clientAdmin         ClientAdmin     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile             EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  structure           SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Restrict)

  @@index([companyId, employeeProfileId, effectiveFrom])
  @@map("employee_salary_assignments")
}

// 9.18 Monthly Payroll Processing Batch
model PayrollBatch {
  id                String           @id @default(uuid()) @db.Char(36)
  companyId         String           @map("company_id") @db.Char(36)
  batchNumber       String           @map("batch_number") @db.VarChar(60)
  month             Int
  year              Int
  periodStartDate   DateTime         @map("period_start_date") @db.Date
  periodEndDate     DateTime         @map("period_end_date") @db.Date
  totalEmployees    Int              @default(0) @map("total_employees")
  totalGross        Decimal          @default(0.00) @map("total_gross") @db.Decimal(15, 2)
  totalDeductions   Decimal          @default(0.00) @map("total_deductions") @db.Decimal(15, 2)
  totalNet          Decimal          @default(0.00) @map("total_net") @db.Decimal(15, 2)
  totalEmployerPf   Decimal          @default(0.00) @map("total_employer_pf") @db.Decimal(15, 2)
  totalEmployerEsi  Decimal          @default(0.00) @map("total_employer_esi") @db.Decimal(15, 2)
  status            String           @default("DRAFT") @db.VarChar(30)
  approvalRequestId String?          @map("approval_request_id") @db.Char(36)
  voucherId         String?          @map("voucher_id") @db.Char(36)
  processedById     String?          @map("processed_by_id") @db.Char(36)
  processedAt       DateTime?        @map("processed_at")
  postedToGlAt      DateTime?        @map("posted_to_gl_at")
  disbursedAt       DateTime?        @map("disbursed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  clientAdmin       ClientAdmin      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  voucher           JournalVoucher?  @relation("PayrollBatchVoucher", fields: [voucherId], references: [id], onDelete: SetNull)
  items             PayrollItem[]

  @@unique([companyId, month, year])
  @@index([companyId, status])
  @@map("payroll_batches")
}

// 9.19 Individual Employee Payroll Calculation Breakdown
model PayrollItem {
  id                  String           @id @default(uuid()) @db.Char(36)
  companyId           String           @map("company_id") @db.Char(36)
  payrollBatchId      String           @map("payroll_batch_id") @db.Char(36)
  employeeProfileId   String           @map("employee_profile_id") @db.Char(36)
  workingDays         Decimal          @map("working_days") @db.Decimal(4, 2)
  paidDays            Decimal          @map("paid_days") @db.Decimal(4, 2)
  lopDays             Decimal          @default(0.00) @map("lop_days") @db.Decimal(4, 2)
  overtimeHours       Decimal          @default(0.00) @map("overtime_hours") @db.Decimal(5, 2)
  grossEarned         Decimal          @map("gross_earned") @db.Decimal(15, 2)
  totalDeductions     Decimal          @map("total_deductions") @db.Decimal(15, 2)
  netPayable          Decimal          @map("net_payable") @db.Decimal(15, 2)
  earningsBreakdown   Json             @map("earnings_breakdown")
  deductionsBreakdown Json             @map("deductions_breakdown")
  employerPf          Decimal          @default(0.00) @map("employer_pf") @db.Decimal(15, 2)
  employerEsi         Decimal          @default(0.00) @map("employer_esi") @db.Decimal(15, 2)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  clientAdmin         ClientAdmin      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollBatch        PayrollBatch     @relation(fields: [payrollBatchId], references: [id], onDelete: Cascade)
  profile             EmployeeProfile  @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  payslip             EmployeePayslip?

  @@unique([payrollBatchId, employeeProfileId])
  @@index([companyId, employeeProfileId])
  @@map("payroll_items")
}

// 9.20 Employee Salary Payslip (Snapshot for ESS & PDF Download)
model EmployeePayslip {
  id                String          @id @default(uuid()) @db.Char(36)
  companyId         String          @map("company_id") @db.Char(36)
  payrollItemId     String          @unique @map("payroll_item_id") @db.Char(36)
  employeeProfileId String          @map("employee_profile_id") @db.Char(36)
  payslipNumber     String          @map("payslip_number") @db.VarChar(80)
  month             Int
  year              Int
  grossAmount       Decimal         @map("gross_amount") @db.Decimal(15, 2)
  deductionsAmount  Decimal         @map("deductions_amount") @db.Decimal(15, 2)
  netAmount         Decimal         @map("net_amount") @db.Decimal(15, 2)
  netAmountInWords  String?         @map("net_amount_in_words") @db.VarChar(255)
  snapshotJson      Json            @map("snapshot_json")
  downloadToken     String          @unique @map("download_token") @db.VarChar(100)
  isPublished       Boolean         @default(false) @map("is_published")
  publishedAt       DateTime?       @map("published_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  clientAdmin       ClientAdmin     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollItem       PayrollItem     @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)
  profile           EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([companyId, employeeProfileId, month, year])
  @@index([companyId, downloadToken])
  @@map("employee_payslips")
}

// 9.21 Configurable Statutory Compliance Rules (EPF, ESIC, PT, TDS)
model StatutoryRule {
  id            String      @id @default(uuid()) @db.Char(36)
  companyId     String      @map("company_id") @db.Char(36)
  ruleType      String      @map("rule_type") @db.VarChar(50)
  effectiveFrom DateTime    @map("effective_from") @db.Date
  effectiveTo   DateTime?   @map("effective_to") @db.Date
  configJson    Json        @map("config_json")
  status        String      @default("ACTIVE") @db.VarChar(30)
  notes         String?     @db.VarChar(255)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  clientAdmin   ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, ruleType, effectiveFrom])
  @@map("statutory_rules")
}


// =========================================================================
// PHASE 10: SOLAR MONITORING MODULES
// =========================================================================

// 10.1 Solar Plants Master
model SolarPlant {
  id                 String                  @id @default(uuid()) @db.Char(36)
  companyId          String                  @map("company_id") @db.Char(36)
  name               String                  @db.VarChar(180)
  code               String                  @db.VarChar(60)
  plantType          String                  @default("ROOFTOP_INDUSTRIAL") @map("plant_type") @db.VarChar(60)
  capacityDcKw       Decimal                 @map("capacity_dc_kw") @db.Decimal(10, 2)
  capacityAcKw       Decimal                 @map("capacity_ac_kw") @db.Decimal(10, 2)
  commissionDate     DateTime?               @map("commission_date") @db.Date
  status             String                  @default("ACTIVE") @db.VarChar(30)
  timezone           String                  @default("Asia/Kolkata") @db.VarChar(50)
  locationAddress    String?                 @map("location_address") @db.VarChar(255)
  city               String?                 @db.VarChar(100)
  state              String?                 @db.VarChar(100)
  pincode            String?                 @db.VarChar(20)
  latitude           Decimal?                @db.Decimal(10, 7)
  longitude          Decimal?                @db.Decimal(10, 7)
  gridVoltage        String?                 @map("grid_voltage") @db.VarChar(60)
  monthlyTargetKwh   Decimal?                @map("monthly_target_kwh") @db.Decimal(12, 2)
  notes              String?                 @db.Text
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  clientAdmin        ClientAdmin             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inverters          SolarInverter[]
  panelStrings       SolarPanelString[]
  apiConfig          SolarPlantApiConfig?
  telemetryLogs      SolarTelemetryLog[]
  alarms             SolarInverterAlarm[]
  cleaningSchedules  SolarCleaningSchedule[]
  maintenanceTickets SolarMaintenanceTicket[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@index([companyId, plantType])
  @@map("solar_plants")
}

// 10.2 Inverter Master & Configuration
model SolarInverter {
  id                String                   @id @default(uuid()) @db.Char(36)
  companyId         String                   @map("company_id") @db.Char(36)
  plantId           String                   @map("plant_id") @db.Char(36)
  inverterCode      String                   @map("inverter_code") @db.VarChar(60)
  make              String                   @db.VarChar(100)
  model             String                   @db.VarChar(120)
  serialNumber      String                   @map("serial_number") @db.VarChar(100)
  ratedCapacityKw   Decimal                  @map("rated_capacity_kw") @db.Decimal(10, 2)
  maxDcPowerKw      Decimal?                 @map("max_dc_power_kw") @db.Decimal(10, 2)
  mpptChannels      Int                      @default(1) @map("mppt_channels")
  stringsPerMppt    Int?                     @map("strings_per_mppt")
  ipAddress         String?                  @map("ip_address") @db.VarChar(50)
  modbusAddress     Int?                     @map("modbus_address")
  gatewayId         String?                  @map("gateway_id") @db.VarChar(100)
  status            String                   @default("OFFLINE") @db.VarChar(30)
  efficiencyPercent Decimal?                 @map("efficiency_percent") @db.Decimal(5, 2)
  lastTelemetryAt   DateTime?                @map("last_telemetry_at")
  notes             String?                  @db.Text
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  clientAdmin       ClientAdmin              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plant             SolarPlant               @relation(fields: [plantId], references: [id], onDelete: Cascade)
  panelStrings      SolarPanelString[]
  telemetryLogs     SolarTelemetryLog[]
  alarms            SolarInverterAlarm[]
  tickets           SolarMaintenanceTicket[]

  @@unique([companyId, plantId, serialNumber])
  @@unique([companyId, plantId, inverterCode])
  @@index([companyId, plantId])
  @@index([companyId, status])
  @@map("solar_inverters")
}

// 10.3 Panel Strings & Layout
model SolarPanelString {
  id             String         @id @default(uuid()) @db.Char(36)
  companyId      String         @map("company_id") @db.Char(36)
  plantId        String         @map("plant_id") @db.Char(36)
  inverterId     String?        @map("inverter_id") @db.Char(36)
  stringId       String         @map("string_id") @db.VarChar(60)
  modulesCount   Int            @map("modules_count")
  moduleModel    String?        @map("module_model") @db.VarChar(120)
  moduleWattageW Int            @map("module_wattage_w")
  totalWattageWp Int?           @map("total_wattage_wp")
  tiltDegrees    Decimal?       @map("tilt_degrees") @db.Decimal(5, 2)
  azimuthDegrees Decimal?       @map("azimuth_degrees") @db.Decimal(5, 2)
  orientation    String?        @db.VarChar(50)
  mpptIndex      Int?           @map("mppt_index")
  vmpRated       Decimal?       @map("vmp_rated") @db.Decimal(8, 2)
  impRated       Decimal?       @map("imp_rated") @db.Decimal(8, 2)
  status         String         @default("ACTIVE") @db.VarChar(30)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  clientAdmin    ClientAdmin    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plant          SolarPlant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  inverter       SolarInverter? @relation(fields: [inverterId], references: [id], onDelete: SetNull)

  @@unique([companyId, plantId, stringId])
  @@index([companyId, plantId])
  @@index([companyId, inverterId])
  @@map("solar_panel_strings")
}

// 10.4 Provider-Independent Plant API Configuration
model SolarPlantApiConfig {
  id                     String      @id @default(uuid()) @db.Char(36)
  companyId              String      @map("company_id") @db.Char(36)
  plantId                String      @unique @map("plant_id") @db.Char(36)
  provider               String      @db.VarChar(60)
  baseUrl                String?     @map("base_url") @db.VarChar(255)
  authType               String      @default("API_KEY") @map("auth_type") @db.VarChar(40)
  encryptedApiKey        String?     @map("encrypted_api_key") @db.Text
  encryptedApiSecret     String?     @map("encrypted_api_secret") @db.Text
  encryptedAccessToken   String?     @map("encrypted_access_token") @db.Text
  encryptedRefreshToken  String?     @map("encrypted_refresh_token") @db.Text
  tokenExpiresAt         DateTime?   @map("token_expires_at")
  pollingIntervalMinutes Int         @default(15) @map("polling_interval_minutes")
  isPollingEnabled       Boolean     @default(false) @map("is_polling_enabled")
  lastPolledAt           DateTime?   @map("last_polled_at")
  webhookToken           String?     @unique @map("webhook_token") @db.VarChar(100)
  webhookSecret          String?     @map("webhook_secret") @db.VarChar(128)
  isWebhookEnabled       Boolean     @default(true) @map("is_webhook_enabled")
  status                 String      @default("INACTIVE") @db.VarChar(30)
  lastSyncStatus         String?     @map("last_sync_status") @db.VarChar(50)
  lastSyncError          String?     @map("last_sync_error") @db.Text
  lastSyncAt             DateTime?   @map("last_sync_at")
  totalReadingsCount     BigInt      @default(0) @map("total_readings_count")
  extraConfigJson        Json?       @map("extra_config_json")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  clientAdmin            ClientAdmin @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plant                  SolarPlant  @relation(fields: [plantId], references: [id], onDelete: Cascade)

  @@index([companyId, provider])
  @@index([companyId, status])
  @@map("solar_plant_api_configs")
}

// 10.5 Time-Series Telemetry Logs
model SolarTelemetryLog {
  id             String        @id @default(uuid()) @db.Char(36)
  companyId      String        @map("company_id") @db.Char(36)
  plantId        String        @map("plant_id") @db.Char(36)
  inverterId     String        @map("inverter_id") @db.Char(36)
  timestamp      DateTime      @db.DateTime(0)
  currentPowerKw Decimal       @map("current_power_kw") @db.Decimal(10, 2)
  dailyEnergyKwh Decimal       @map("daily_energy_kwh") @db.Decimal(12, 2)
  totalEnergyKwh Decimal       @map("total_energy_kwh") @db.Decimal(14, 2)
  gridVoltageV   Decimal?      @map("grid_voltage_v") @db.Decimal(8, 2)
  gridCurrentA   Decimal?      @map("grid_current_a") @db.Decimal(8, 2)
  frequencyHz    Decimal?      @map("frequency_hz") @db.Decimal(6, 2)
  powerFactor    Decimal?      @map("power_factor") @db.Decimal(4, 3)
  dcPowerKw      Decimal?      @map("dc_power_kw") @db.Decimal(10, 2)
  dcVoltageV     Decimal?      @map("dc_voltage_v") @db.Decimal(8, 2)
  dcCurrentA     Decimal?      @map("dc_current_a") @db.Decimal(8, 2)
  temperatureC   Decimal?      @map("temperature_c") @db.Decimal(6, 2)
  irradianceWm2  Decimal?      @map("irradiance_wm2") @db.Decimal(8, 2)
  ambientTempC   Decimal?      @map("ambient_temp_c") @db.Decimal(6, 2)
  inverterStatus String        @default("NORMAL") @map("inverter_status") @db.VarChar(30)
  rawPayloadJson Json?         @map("raw_payload_json")
  isSimulated    Boolean       @default(false) @map("is_simulated")
  createdAt      DateTime      @default(now()) @map("created_at")

  clientAdmin    ClientAdmin   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plant          SolarPlant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  inverter       SolarInverter @relation(fields: [inverterId], references: [id], onDelete: Cascade)

  @@unique([inverterId, timestamp])
  @@index([companyId, plantId, timestamp])
  @@index([companyId, timestamp])
  @@index([plantId, timestamp])
  @@map("solar_telemetry_logs")
}

// 10.6 Inverter Alarms & Faults
model SolarInverterAlarm {
  id                   String                  @id @default(uuid()) @db.Char(36)
  companyId            String                  @map("company_id") @db.Char(36)
  plantId              String                  @map("plant_id") @db.Char(36)
  inverterId           String                  @map("inverter_id") @db.Char(36)
  alarmCode            String                  @map("alarm_code") @db.VarChar(60)
  severity             String                  @default("WARNING") @db.VarChar(30)
  category             String?                 @db.VarChar(60)
  description          String                  @db.VarChar(255)
  triggeredAt          DateTime                @default(now()) @map("triggered_at")
  status               String                  @default("ACTIVE") @db.VarChar(30)
  acknowledgedAt       DateTime?               @map("acknowledged_at")
  acknowledgedBy       String?                 @map("acknowledged_by") @db.VarChar(150)
  acknowledgementNotes String?                 @map("acknowledgement_notes") @db.Text
  resolvedAt           DateTime?               @map("resolved_at")
  resolvedBy           String?                 @map("resolved_by") @db.VarChar(150)
  resolutionNotes      String?                 @map("resolution_notes") @db.Text
  ticketId             String?                 @map("ticket_id") @db.Char(36)
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  clientAdmin          ClientAdmin             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plant                SolarPlant              @relation(fields: [plantId], references: [id], onDelete: Cascade)
  inverter             SolarInverter           @relation(fields: [inverterId], references: [id], onDelete: Cascade)
  maintenanceTicket    SolarMaintenanceTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([companyId, plantId, status])
  @@index([inverterId, status])
  @@index([companyId, severity, status])
  @@index([companyId, triggeredAt])
  @@map("solar_inverter_alarms")
}

// 10.7 Cleaning Schedules & Array Wash Cycles
model SolarCleaningSchedule {
  id                          String           @id @default(uuid()) @db.Char(36)
  companyId                   String           @map("company_id") @db.Char(36)
  plantId                     String           @map("plant_id") @db.Char(36)
  arrayBlock                  String           @map("array_block") @db.VarChar(100)
  frequency                   String           @default("MONTHLY") @db.VarChar(40)
  lastCleanedDate             DateTime?        @map("last_cleaned_date") @db.Date
  nextDueDate                 DateTime         @map("next_due_date") @db.Date
  status                      String           @default("SCHEDULED") @db.VarChar(30)
  inspectorId                 String?          @map("inspector_id") @db.Char(36)
  inspectorName               String?          @map("inspector_name") @db.VarChar(150)
  completedAt                 DateTime?        @map("completed_at")
  waterUsedLiters             Decimal?         @map("water_used_liters") @db.Decimal(10, 2)
  soilingLossEstimatedPercent Decimal?         @map("soiling_loss_estimated_percent") @db.Decimal(5, 2)
  cleaningMethod              String?          @map("cleaning_method") @db.VarChar(60)
  inspectionRemarks           String?          @map("inspection_remarks") @db.Text
  createdAt                   DateTime         @default(now()) @map("created_at")
  updatedAt                   DateTime         @updatedAt @map("updated_at")

  clientAdmin                 ClientAdmin      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plant                       SolarPlant       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  inspector                   CompanyEmployee? @relation("SolarCleaningInspector", fields: [inspectorId], references: [id], onDelete: SetNull)

  @@index([companyId, plantId, status])
  @@index([companyId, nextDueDate])
  @@index([inspectorId])
  @@map("solar_cleaning_schedules")
}

// 10.8 Maintenance Tickets & Spares Issuance Reference
model SolarMaintenanceTicket {
  id                   String               @id @default(uuid()) @db.Char(36)
  companyId            String               @map("company_id") @db.Char(36)
  plantId              String               @map("plant_id") @db.Char(36)
  inverterId           String?              @map("inverter_id") @db.Char(36)
  ticketNo             String               @map("ticket_no") @db.VarChar(60)
  category             String               @db.VarChar(60)
  priority             String               @default("MEDIUM") @db.VarChar(30)
  subject              String               @db.VarChar(180)
  description          String               @db.Text
  assignedTechnicianId String?              @map("assigned_technician_id") @db.Char(36)
  technicianName       String?              @map("technician_name") @db.VarChar(150)
  status               String               @default("OPEN") @db.VarChar(30)
  sparePartsDetails    Json?                @map("spare_parts_details")
  rootCause            String?              @map("root_cause") @db.Text
  actionTaken          String?              @map("action_taken") @db.Text
  resolutionNotes      String?              @map("resolution_notes") @db.Text
  resolvedAt           DateTime?            @map("resolved_at")
  closedAt             DateTime?            @map("closed_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  clientAdmin          ClientAdmin          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plant                SolarPlant           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  inverter             SolarInverter?       @relation(fields: [inverterId], references: [id], onDelete: SetNull)
  assignedTechnician   CompanyEmployee?     @relation("SolarTicketTechnician", fields: [assignedTechnicianId], references: [id], onDelete: SetNull)
  alarms               SolarInverterAlarm[]

  @@unique([companyId, ticketNo])
  @@index([companyId, plantId, status])
  @@index([inverterId])
  @@index([assignedTechnicianId])
  @@index([companyId, priority, status])
  @@map("solar_maintenance_tickets")
}
