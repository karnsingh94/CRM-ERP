  id                String    @id @default(uuid()) @db.Char(36)
  companyId         String    @map("company_id") @db.Char(36)
  stockId           String?   @map("stock_id") @db.Char(36)
  productId         String?   @map("product_id") @db.Char(36)
  sku               String    @db.VarChar(60)
  batchNo           String    @map("batch_no") @db.VarChar(60)
  warehouse         String    @default("Main Warehouse") @db.VarChar(100)
  manufacturingDate DateTime? @map("manufacturing_date")
  expiryDate        DateTime? @map("expiry_date")
  receivedDate      DateTime  @default(now()) @map("received_date")
  vendorId          String?   @map("vendor_id") @db.Char(36)
  vendorName        String?   @map("vendor_name") @db.VarChar(180)
  grnId             String?   @map("grn_id") @db.Char(36)
  grnNo             String?   @map("grn_no") @db.VarChar(60)
  initialQty        Int       @default(0) @map("initial_qty")
  availableQty      Int       @default(0) @map("available_qty")
  reservedQty       Int       @default(0) @map("reserved_qty")
  wipQty            Int       @default(0) @map("wip_qty")
  qualityHoldQty    Int       @default(0) @map("quality_hold_qty")
  rejectedQty       Int       @default(0) @map("rejected_qty")
  samplingQty       Int       @default(0) @map("sampling_qty")
  returnHoldQty     Int       @default(0) @map("return_hold_qty")
  scrapQty          Int       @default(0) @map("scrap_qty")
  qualityStatus     String    @default("ACCEPTED") @map("quality_status") @db.VarChar(40)
  status            String    @default("ACTIVE") @db.VarChar(30)
  unitCost          Decimal   @default(0) @map("unit_cost") @db.Decimal(15, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  clientAdmin ClientAdmin     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stock       InventoryStock? @relation(fields: [stockId], references: [id], onDelete: SetNull)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([companyId, sku, batchNo, warehouse])
  @@index([companyId, batchNo])
  @@index([companyId, sku, warehouse])
  @@index([companyId, status, expiryDate])
  @@map("inventory_batches")
}

