  @@unique([companyId, quoteNo])
  @@unique([requestId, vendorId])
  @@index([companyId, status, quoteDate])
  @@map("purchase_quotations")
}

model PurchaseOrder {
  id              String    @id @default(uuid()) @db.Char(36)
  companyId       String    @map("company_id") @db.Char(36)
  requestId       String    @map("request_id") @db.Char(36)
  quotationId     String    @unique @map("quotation_id") @db.Char(36)
  vendorId        String    @map("vendor_id") @db.Char(36)
  poNumber        String    @map("po_number") @db.VarChar(60)
  orderDate       DateTime  @default(now()) @map("order_date")
  expectedDate    DateTime? @map("expected_date")
  items           Json
  subtotal        Decimal   @default(0) @db.Decimal(15, 2)
  taxAmount       Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  freightAmount   Decimal   @default(0) @map("freight_amount") @db.Decimal(15, 2)
  totalAmount     Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  deliveryAddress String?   @map("delivery_address") @db.Text
  paymentTerms    String?   @map("payment_terms") @db.VarChar(100)
  terms           String?   @db.Text
  status          String    @default("ISSUED") @db.VarChar(50)
  issuedBy        String?   @map("issued_by") @db.VarChar(150)
  closedAt        DateTime? @map("closed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  clientAdmin ClientAdmin       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request     PurchaseRequest   @relation(fields: [requestId], references: [id], onDelete: Restrict)
