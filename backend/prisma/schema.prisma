// 9.14 Raw Biometric Punch Log Buffer
model BiometricPunchLog {
  id                String           @id @default(uuid()) @db.Char(36)
  companyId         String           @map("company_id") @db.Char(36)
  deviceId          String?          @map("device_id") @db.Char(36)
