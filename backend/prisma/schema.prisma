enum BomStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum ProductionOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  MATERIAL_PENDING
  READY_FOR_PRODUCTION
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProcessStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  FAILED
}

enum ManufacturingQcStatus {
  PENDING
  IN_PROGRESS
  PASSED
  FAILED
  QUALITY_HOLD
}

enum ReprocessingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

