  approvedById      String?         @map("approved_by_id") @db.Char(36)
  approvedAt        DateTime?       @map("approved_at")
  rejectionReason   String?         @map("rejection_reason") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  clientAdmin       ClientAdmin     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile           EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeProfileId, attendanceDate])
  @@map("attendance_regularizations")
}

