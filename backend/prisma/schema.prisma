  source            String          @default("BIOMETRIC") @db.VarChar(30)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  clientAdmin       ClientAdmin     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  profile           EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  shift             ShiftPolicy?    @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([companyId, employeeProfileId, attendanceDate])
  @@index([companyId, attendanceDate, status])
  @@map("daily_attendances")
}

// 9.8 Attendance Regularization Requests
model AttendanceRegularization {
  id                String          @id @default(uuid()) @db.Char(36)
  companyId         String          @map("company_id") @db.Char(36)
  employeeProfileId String          @map("employee_profile_id") @db.Char(36)
  attendanceDate    DateTime        @map("attendance_date") @db.Date
