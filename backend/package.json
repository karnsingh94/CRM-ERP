{
  "name": "crm-erp-backend",
  "version": "1.0.0",
  "description": "Backend API for CRM & ERP system",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/nodemon/bin/nodemon.js src/server.js",
    "start": "node src/server.js",
    "test": "node tests/integration/suite.test.js",
    "test:departments": "node tests/integration/departments.test.js",
    "test:activation": "node tests/integration/activation_deactivation.test.js",
    "test:crm-flow": "node tests/integration/crm_sales_flow.test.js",
    "test:check-perms": "node tests/integration/client_check_permissions.test.js",
    "test:permissions": "node tests/integration/permission_propagation.test.js",
    "check:db": "node scripts/check-db.js",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "seed": "node prisma/seed.js",
    "prisma:studio": "node node_modules/prisma/build/index.js studio"
  },
  "keywords": [
    "crm",
    "erp",
    "express",
    "prisma",
    "mysql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.4.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "6.4.1"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
