# ==============================================================================
# AZZUNIQE CRM & ERP — Backend Environment Configuration Template
# Copy this file to .env and supply environment-specific credentials.
# NEVER commit the real .env file into version control.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Server Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# MySQL Database Connection String (Prisma format)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/crm_erp_db"

# Primary Frontend Client URL (for CORS and Reset Links)
CLIENT_URL="http://localhost:3000"

# Optional comma-separated additional origins for CORS (e.g. production domain, staging)
# ADDITIONAL_CORS_ORIGINS="https://admin.azzuniqe.com,https://company.azzuniqe.com"

# Mail Delivery Service Configuration (SMTP)
# Optional: Configure for sending transactional emails (such as password reset links)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="no-reply@azzuniqe.com"
SMTP_PASS="your_smtp_password"
SMTP_FROM="AZZUNIQE Security <no-reply@azzuniqe.com>"

